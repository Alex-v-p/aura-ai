# Aura deployment configuration. Copy to .env locally; keep the real file out
# of source control. Secret values belong in the files named below.

AURA_WEB_PORT=4200
# Replace these example-domain placeholders with stable HTTPS names resolvable
# by the browser and Core. Do not use localhost or a Compose service name.
AURA_PUBLIC_ORIGIN=https://aura.example.invalid
AURA_STATE_ROOT=/srv/aura-state-encrypted

AURA_CORE_DATABASE_NAME=aura
AURA_CORE_DATABASE_USER=aura
AURA_CORE_POSTGRES_IMAGE=pgvector/pgvector:pg17
AURA_NATS_IMAGE=nats:2.10.22-alpine
AURA_VALKEY_IMAGE=valkey/valkey:8.1-alpine
AURA_CORE_DATABASE_PASSWORD_FILE=./.secrets/aura-core-database-password
AURA_OIDC_CLIENT_SECRET_FILE=./.secrets/aura-oidc-client-secret
AURA_NATS_PASSWORD_FILE=./.secrets/aura-nats-password
AURA_VALKEY_PASSWORD_FILE=./.secrets/aura-valkey-password

# Core reaches Ollama over the trusted LAN. The Compose default resolves the
# Linux host through Docker's host-gateway mapping; set this to a stable,
# operator-controlled LAN URL when Ollama is elsewhere. Do not expose this
# endpoint to the browser or put a real homelab address in a committed example.
AURA_OLLAMA_URL=http://host.docker.internal:11434
AURA_DEFAULT_MODEL=
AURA_CONTEXT_TOKEN_BUDGET=8192
AURA_OLLAMA_RUN_TIMEOUT_SECONDS=300
# Metadata-only model inventory is intentionally short-lived and independent
# from normal inference. Selecting a memory model may perform one bounded,
# content-free provider verification using the second timeout.
AURA_OLLAMA_INVENTORY_TIMEOUT_SECONDS=5
AURA_OLLAMA_VERIFICATION_TIMEOUT_SECONDS=60
AURA_OLLAMA_INVENTORY_CACHE_TTL_SECONDS=15

# Authentik remains an OIDC provider boundary. The local-identity Compose
# profile is temporary development infrastructure and is optional.
AURA_OIDC_ISSUER=https://authentik.example.invalid
# Preserve these exact values if local Authentik is later relocated. They are
# also required by the explicit local-identity override.
AURA_OIDC_AUDIENCE=aura-web
AURA_OIDC_CLIENT_ID=aura-web
AURA_OIDC_REDIRECT_URI=https://aura.example.invalid/api/v1/auth/callback
# Required: the exact OIDC `sub` value of the configured Aura owner.
AURA_OWNER_SUBJECT=
AURA_SECURE_COOKIES=true

# The following inputs are used only with the explicit
# deploy/compose/local-identity.yaml override. Normal `docker compose config`
# and the normal Aura stack do not read or require them.
# These paths are runtime secret inputs, not values to commit.
AUTHENTIK_DATABASE_PASSWORD_FILE=./.secrets/authentik-database-password
AUTHENTIK_SECRET_KEY_FILE=./.secrets/authentik-secret-key
AUTHENTIK_BOOTSTRAP_PASSWORD_FILE=./.secrets/authentik-bootstrap-password
AUTHENTIK_VALKEY_PASSWORD_FILE=./.secrets/authentik-valkey-password
AUTHENTIK_POSTGRES_IMAGE=postgres:16-alpine
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_HOST_BROWSER=https://authentik.example.invalid
AUTHENTIK_OWNER_USERNAME=aura-owner
AUTHENTIK_OWNER_NAME=Aura Owner
AUTHENTIK_OWNER_PASSWORD_FILE=./.secrets/authentik-owner-password

# Verified immutable Authentik 2026.5.7 multi-architecture release. Operators
# may override it only with another digest-qualified, verified image.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server@sha256:76bf433fd434c067cb25dc3e197cee793998441cda912441ea275293e76cc32c
AUTHENTIK_PORT=9000

# The explicit local HTTP helper writes these same values to the ignored
# .env.local-http overlay. Do not copy them into the normal production .env.
