# Aura deployment configuration. Copy to .env locally; keep the real file out
# of source control. Secret values belong in the files named below.

AURA_WEB_PORT=4200
# Replace these example-domain placeholders with stable HTTPS names resolvable
# by the browser and Core. Do not use localhost or a Compose service name.
AURA_PUBLIC_ORIGIN=https://aura.example.invalid
AURA_STATE_ROOT=/srv/aura-state-encrypted

AURA_CORE_DATABASE_NAME=aura
AURA_CORE_DATABASE_USER=aura
AURA_CORE_POSTGRES_IMAGE=pgvector/pgvector:pg17
AURA_NATS_IMAGE=nats:2.10.22-alpine
AURA_VALKEY_IMAGE=valkey/valkey:8.1-alpine
AURA_CORE_DATABASE_PASSWORD_FILE=./.secrets/aura-core-database-password
AURA_OIDC_CLIENT_SECRET_FILE=./.secrets/aura-oidc-client-secret
AURA_NATS_PASSWORD_FILE=./.secrets/aura-nats-password
AURA_NATS_USER=aura
# One-shot JetStream administration identity. It is used only by the
# evaluation bootstrap job and is never mounted into Core, Observatory, or the
# runner.
AURA_NATS_BOOTSTRAP_USER=aura-evaluation-bootstrap
AURA_NATS_BOOTSTRAP_PASSWORD_FILE=./.secrets/aura-nats-bootstrap-password
# Evaluation dispatch publishes requests/cancellations and consumes results.
# The runner publishes results and consumes requests/cancellations. Keep both
# credentials distinct and file-backed; neither is the normal Core identity.
AURA_NATS_DISPATCH_USER=aura-evaluation-dispatch
AURA_NATS_DISPATCH_PASSWORD_FILE=./.secrets/aura-nats-dispatch-password
AURA_NATS_RUNNER_USER=aura-evaluation-runner
AURA_NATS_RUNNER_PASSWORD_FILE=./.secrets/aura-nats-runner-password
# Dedicated pull-consumer identity for the governed run-evidence channel.
# It has no publish access to Core or evaluation subjects.
AURA_NATS_RUN_EVIDENCE_USER=aura-observatory-run-evidence
AURA_NATS_RUN_EVIDENCE_PASSWORD_FILE=./.secrets/aura-nats-run-evidence-password
AURA_NATS_RUN_EVIDENCE_BOOTSTRAP_USER=aura-run-evidence-bootstrap
AURA_NATS_RUN_EVIDENCE_BOOTSTRAP_PASSWORD_FILE=./.secrets/aura-nats-run-evidence-bootstrap-password
AURA_VALKEY_PASSWORD_FILE=./.secrets/aura-valkey-password

# Garage is private and has no host/browser port. Supply a reviewed,
# immutable image reference; do not use a mutable tag. The value is required
# because image verification is an operator/deployment concern.
AURA_GARAGE_IMAGE=dxflrs/garage:v2.1.0@sha256:4c9b34c113e61358466e83fd6e7d66e6d18657ede14b776eb78a93ee8da7cf6a
AURA_GARAGE_CONFIG_IMAGE=busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
AURA_GARAGE_REGION=garage
AURA_GARAGE_BUCKET=aura-documents
AURA_GARAGE_RPC_SECRET_FILE=./.secrets/aura-garage-rpc-secret
AURA_GARAGE_ACCESS_KEY_FILE=./.secrets/aura-garage-access-key
AURA_GARAGE_SECRET_KEY_FILE=./.secrets/aura-garage-secret-key
# Observatory evaluation artifacts use a separate least-privilege Garage key
# and bucket. Never reuse the Core key or place either credential in this file.
AURA_OBSERVATORY_GARAGE_BUCKET=aura-observatory-evaluation
AURA_OBSERVATORY_GARAGE_ACCESS_KEY_FILE=./.secrets/observatory-garage-access-key
AURA_OBSERVATORY_GARAGE_SECRET_KEY_FILE=./.secrets/observatory-garage-secret-key
# The Core runner gets a separate read/write key scoped to the evaluation
# bucket. It is never reused by Core or the Observatory worker.
AURA_EVALUATION_RUNNER_GARAGE_ACCESS_KEY_FILE=./.secrets/aura-evaluation-runner-garage-access-key
AURA_EVALUATION_RUNNER_GARAGE_SECRET_KEY_FILE=./.secrets/aura-evaluation-runner-garage-secret-key
# Run evidence uses a dedicated bucket. The worker is write-only; the API
# receives a separate read/delete-capable identity.
AURA_OBSERVATORY_RUN_EVIDENCE_OBJECT_BUCKET=aura-observatory-run-evidence
AURA_OBSERVATORY_RUN_EVIDENCE_WORKER_ACCESS_KEY_FILE=./.secrets/observatory-run-evidence-worker-access-key
AURA_OBSERVATORY_RUN_EVIDENCE_WORKER_SECRET_KEY_FILE=./.secrets/observatory-run-evidence-worker-secret-key
AURA_OBSERVATORY_RUN_EVIDENCE_API_ACCESS_KEY_FILE=./.secrets/observatory-run-evidence-api-access-key
AURA_OBSERVATORY_RUN_EVIDENCE_API_SECRET_KEY_FILE=./.secrets/observatory-run-evidence-api-secret-key
# The runner uses a separate PostgreSQL login limited to its ledger/outbox
# tables. The Core owner/database password is never mounted into the runner.
AURA_EVALUATION_RUNNER_DATABASE_USER=aura_evaluation_runner
AURA_EVALUATION_RUNNER_DATABASE_PASSWORD_FILE=./.secrets/aura-evaluation-runner-database-password

# Explicit private Compose networks prevent Docker's automatic IPAM from
# shadowing the Ollama LAN or a VPN route. Override these on hosts where the
# reserved ranges conflict with another trusted network. Each /28 provides 14
# container addresses; the defaults are disjoint from 192.168.0.0/24.
AURA_OBJECT_STORAGE_SUBNET=10.254.240.0/28
AURA_DOCUMENT_PARSER_SUBNET=10.254.240.16/28
AURA_OBSERVATORY_OBJECT_STORAGE_SUBNET=10.254.242.0/28
# The browser-facing Core network is explicitly reserved so Docker cannot
# shadow a trusted Ollama LAN or VPN route. Override when this range conflicts.
AURA_FRONTEND_SUBNET=10.254.241.0/24

# Core reaches Ollama over the trusted LAN. The Compose default resolves the
# Linux host through Docker's host-gateway mapping; set this to a stable,
# operator-controlled LAN URL when Ollama is elsewhere. Do not expose this
# endpoint to the browser or put a real homelab address in a committed example.
AURA_OLLAMA_URL=http://host.docker.internal:11434
# Optional Docker Desktop LAN workaround for hosts where containers cannot
# route directly to Ollama. The local launcher starts a transient user-level
# socat relay bound only to 127.0.0.1 and rewrites the local Compose URL to
# host.docker.internal:11435. Leave the target empty when direct routing works.
AURA_LOCAL_OLLAMA_RELAY_TARGET=
AURA_LOCAL_OLLAMA_RELAY_PORT=11435
AURA_DEFAULT_MODEL=
# Documents use Qwen3 Matryoshka embeddings at the existing vector(768)
# index width. Memory embedding configuration remains independently owned.
AURA_DOCUMENT_EMBEDDING_MODEL=qwen3-embedding:4b
AURA_DOCUMENT_EMBEDDING_DIMENSION=768
AURA_CONTEXT_TOKEN_BUDGET=8192
AURA_OLLAMA_RUN_TIMEOUT_SECONDS=300
# Metadata-only model inventory is intentionally short-lived and independent
# from normal inference. Selecting a memory model may perform one bounded,
# content-free provider verification using the second timeout.
AURA_OLLAMA_INVENTORY_TIMEOUT_SECONDS=5
AURA_OLLAMA_VERIFICATION_TIMEOUT_SECONDS=60
AURA_OLLAMA_INVENTORY_CACHE_TTL_SECONDS=15

# Metadata-only Observatory export is opt-in. Core retains its structured
# container-log exporter when this path is disabled or unavailable.
AURA_TELEMETRY_OTLP_ENABLED=false
AURA_TELEMETRY_OTLP_ENDPOINT=http://observatory-collector:4318/v1/observations
AURA_TELEMETRY_OTLP_QUEUE_CAPACITY=32
AURA_TELEMETRY_OTLP_MAX_ATTEMPTS=3
AURA_TELEMETRY_OTLP_TIMEOUT_SECONDS=2
AURA_TELEMETRY_DEPLOYMENT_ID=local
AURA_TELEMETRY_GIT_COMMIT=0000000
AURA_TELEMETRY_HOST_ID=local
# Optional bounded deployment markers. Keep these trusted, content-free
# identifiers; the local defaults are intentionally non-secret placeholders.
AURA_TELEMETRY_IMAGE_VERSION=local
AURA_TELEMETRY_CONFIGURATION_VERSION=local
# Run-evidence capture is disabled unless the owner explicitly opts in with
# full_content for this deployment. The revision is included in each envelope.
AURA_RUN_EVIDENCE_CAPTURE_POLICY=
AURA_RUN_EVIDENCE_CAPTURE_REVISION=full-content-v1

# Authentik remains an OIDC provider boundary. The local-identity Compose
# profile is temporary development infrastructure and is optional.
AURA_OIDC_ISSUER=https://authentik.example.invalid
# Preserve these exact values if local Authentik is later relocated. They are
# also required by the explicit local-identity override.
AURA_OIDC_AUDIENCE=aura-web
AURA_OIDC_CLIENT_ID=aura-web
AURA_OIDC_REDIRECT_URI=https://aura.example.invalid/api/v1/auth/callback
# Required: the exact OIDC `sub` value of the configured Aura owner.
AURA_OWNER_SUBJECT=
AURA_SECURE_COOKIES=true

# Read-only Google Calendar OAuth is disabled by default. The base stack and
# local-http overlay do not consume the following opt-in values. Enable only
# through deploy/compose/google-calendar.yaml after providing the API-only
# runtime files below. The client secret and versioned
# AES-256-GCM key ring are never environment values, browser values, logs, or
# source-controlled content. The key ring retains decrypt-only keys during
# rotation; durable credential encryption is implemented in AURA-0130.
AURA_GOOGLE_CALENDAR_ENABLED=false
AURA_GOOGLE_CALENDAR_CLIENT_ID=
AURA_GOOGLE_CALENDAR_CLIENT_SECRET_FILE=./.secrets/aura-google-calendar-client-secret
AURA_PROVIDER_CREDENTIAL_KEY_RING_FILE=./.secrets/aura-provider-credential-key-ring.json
# Start the opt-in overlay only with:
# docker compose -f compose.yaml -f deploy/compose/google-calendar.yaml up
# The application fixes the scope to https://www.googleapis.com/auth/calendar.readonly
# and the callback to the configured origin plus /api/v1/integrations/calendar/callback.

# Optional Aura Observatory deployment. Enable with
# `docker compose --profile observatory up --build --detach --wait`.
# The browser-facing origin is loopback-only for disposable local HTTP and
# must be changed to a stable HTTPS origin with secure cookies in deployment.
AURA_OBSERVATORY_PORT=4300
AURA_OBSERVATORY_ENVIRONMENT=production
AURA_OBSERVATORY_PUBLIC_ORIGIN=https://observatory.example.invalid
AURA_OBSERVATORY_OIDC_ISSUER=https://authentik.example.invalid/application/o/aura-observatory/
AURA_OBSERVATORY_OIDC_AUDIENCE=aura-observatory
AURA_OBSERVATORY_OIDC_CLIENT_ID=aura-observatory
AURA_OBSERVATORY_OIDC_REDIRECT_URI=https://observatory.example.invalid/api/v1/auth/callback
# Required: exact OIDC `sub` for the configured Observatory owner.
AURA_OBSERVATORY_OWNER_SUBJECT=
AURA_OBSERVATORY_SECURE_COOKIES=true
AURA_OBSERVATORY_DATABASE_NAME=aura_observatory
AURA_OBSERVATORY_DATABASE_USER=observatory
AURA_OBSERVATORY_DATABASE_PASSWORD_FILE=./.secrets/observatory-database-password
AURA_OBSERVATORY_OIDC_CLIENT_SECRET_FILE=./.secrets/observatory-oidc-client-secret
AURA_OBSERVATORY_SESSION_PASSWORD_FILE=./.secrets/observatory-session-password
AURA_OBSERVATORY_INGEST_CREDENTIAL_FILE=./.secrets/observatory-ingest-credential
AURA_OBSERVATORY_CLICKHOUSE_PASSWORD_FILE=./.secrets/observatory-clickhouse-password
AURA_OBSERVATORY_CLICKHOUSE_USER=observatory
AURA_OBSERVATORY_EVALUATION_OBJECT_ENDPOINT=http://aura-garage:3900
AURA_OBSERVATORY_EVALUATION_OBJECT_REGION=garage
AURA_OBSERVATORY_EVALUATION_OBJECT_BUCKET=aura-observatory-evaluation
AURA_OBSERVATORY_EVALUATION_OBJECT_ACCESS_KEY_FILE=/run/secrets/observatory-garage-access-key
AURA_OBSERVATORY_EVALUATION_OBJECT_SECRET_KEY_FILE=/run/secrets/observatory-garage-secret-key
AURA_OBSERVATORY_EVALUATION_ARTIFACT_MAX_BYTES=16777216
# Local judge artifacts use a separate read-only Garage identity. The
# credential files are generated/preserved by local-http.sh and are never
# shared with the Observatory write identity.
AURA_OBSERVATORY_JUDGE_OBJECT_ACCESS_KEY_FILE=./.secrets/observatory-judge-garage-access-key
AURA_OBSERVATORY_JUDGE_OBJECT_SECRET_KEY_FILE=./.secrets/observatory-judge-garage-secret-key
AURA_OBSERVATORY_LOCAL_JUDGE_ORIGIN=http://host.docker.internal:11434
AURA_OBSERVATORY_LOCAL_JUDGE_TIMEOUT_SECONDS=120
AURA_OBSERVATORY_LOCAL_JUDGE_MAX_CONCURRENCY=1
# Durable evaluation orchestration is isolated from telemetry ingestion. The
# worker uses the existing least-privilege dispatch identity; the DB-only
# scheduler receives no broker or artifact credentials.
AURA_OBSERVATORY_EVALUATION_WORKER_ID=observatory-evaluation-worker
AURA_OBSERVATORY_EVALUATION_SCHEDULER_ID=observatory-evaluation-scheduler
AURA_OBSERVATORY_EVALUATION_BATCH_SIZE=32
AURA_OBSERVATORY_EVALUATION_POLL_SECONDS=2
AURA_OBSERVATORY_EVALUATION_LEASE_SECONDS=120
AURA_OBSERVATORY_EVALUATION_MAX_ATTEMPTS=3
AURA_OBSERVATORY_EVALUATION_RETRY_BASE_SECONDS=10
AURA_OBSERVATORY_EVALUATION_RETRY_MAX_SECONDS=3600
AURA_OBSERVATORY_EVALUATION_MAX_ENVELOPE_BYTES=1000000
AURA_OBSERVATORY_EVALUATION_NATS_URL=nats://aura-nats:4222
AURA_OBSERVATORY_EVALUATION_NATS_USER=aura-evaluation-dispatch
AURA_OBSERVATORY_EVALUATION_NATS_PASSWORD_FILE=./.secrets/aura-nats-dispatch-password
# Governed run-evidence consumer settings are isolated from evaluation NATS.
AURA_OBSERVATORY_RUN_EVIDENCE_NATS_URL=nats://aura-nats:4222
AURA_OBSERVATORY_RUN_EVIDENCE_NATS_USER=aura-observatory-run-evidence
AURA_OBSERVATORY_RUN_EVIDENCE_NATS_PASSWORD_FILE=./.secrets/aura-nats-run-evidence-password
AURA_OBSERVATORY_RUN_EVIDENCE_NATS_DURABLE=aura-observatory-run-evidence
AURA_OBSERVATORY_RUN_EVIDENCE_OBJECT_ENDPOINT=http://aura-garage:3900
AURA_OBSERVATORY_RUN_EVIDENCE_OBJECT_REGION=garage
AURA_OBSERVATORY_RUN_EVIDENCE_MAX_ENVELOPE_BYTES=1500000
AURA_RUN_EVIDENCE_MAX_BYTES=1048576
# Observatory evaluation process spans are bounded metadata-only OTLP.
AURA_OBSERVATORY_TELEMETRY_OTLP_ENABLED=true
AURA_OBSERVATORY_TELEMETRY_OTLP_ENDPOINT=http://observatory-collector:4318/v1/traces
AURA_OBSERVATORY_DEPLOYMENT_ID=local
AURA_OBSERVATORY_DEPLOYMENT_COMMIT=0000000
AURA_OBSERVATORY_DEPLOYMENT_HOST=local
AURA_EVALUATION_RUNNER_MAX_CONCURRENCY=2
AURA_EVALUATION_RUNNER_MAX_QUEUE_DEPTH=32
AURA_EVALUATION_RUNNER_MAX_TIMEOUT_MS=300000
AURA_EVALUATION_RUNNER_MAX_CASES=100
AURA_EVALUATION_RUNNER_MAX_INPUT_BYTES=16777216
AURA_EVALUATION_RUNNER_MAX_OUTPUT_BYTES=16777216
AURA_EVALUATION_RUNNER_MAX_TOKENS=1000000
AURA_EVALUATION_RUNNER_MAX_MODEL_CALLS=100
AURA_EVALUATION_RUNNER_MAX_ARTIFACT_OPERATIONS=100
# The runner always derives fixture identity from the selected registered
# adapter. Leave this unset unless deployment validation intentionally pins the
# exact adapter-owned revision.
AURA_EVALUATION_RUNTIME_FIXTURE_REVISION=
AURA_EVALUATION_RUNTIME_PROMPT_REVISION=prompt-v1
AURA_EVALUATION_RUNTIME_POLICY_REVISION=policy-v1
AURA_OBSERVATORY_POSTGRES_IMAGE=postgres:17-alpine
AURA_OBSERVATORY_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.8
AURA_OBSERVATORY_SESSION_IMAGE=valkey/valkey:8.1-alpine
AURA_OBSERVATORY_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.138.0
AURA_OBSERVATORY_WEB_IMAGE=nginx:1.29-alpine
# Disposable local HTTP is permitted only through deploy/compose/local-http.yaml:
# it sets the exact observatory.localhost:4300 origin and disables secure
# cookies for that development overlay. All other environments require HTTPS.

# The following inputs are used only with the explicit
# deploy/compose/local-identity.yaml override. Normal `docker compose config`
# and the normal Aura stack do not read or require them.
# These paths are runtime secret inputs, not values to commit.
AUTHENTIK_DATABASE_PASSWORD_FILE=./.secrets/authentik-database-password
AUTHENTIK_SECRET_KEY_FILE=./.secrets/authentik-secret-key
AUTHENTIK_BOOTSTRAP_PASSWORD_FILE=./.secrets/authentik-bootstrap-password
AUTHENTIK_VALKEY_PASSWORD_FILE=./.secrets/authentik-valkey-password
AUTHENTIK_POSTGRES_IMAGE=postgres:16-alpine
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_HOST_BROWSER=https://authentik.example.invalid
AUTHENTIK_OWNER_USERNAME=aura-owner
AUTHENTIK_OWNER_NAME=Aura Owner
AUTHENTIK_OWNER_PASSWORD_FILE=./.secrets/authentik-owner-password

# Verified immutable Authentik 2026.5.7 multi-architecture release. Operators
# may override it only with another digest-qualified, verified image.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server@sha256:76bf433fd434c067cb25dc3e197cee793998441cda912441ea275293e76cc32c
AUTHENTIK_PORT=9000

# The explicit local HTTP helper writes these same values to the ignored
# .env.local-http overlay. Do not copy them into the normal production .env.
