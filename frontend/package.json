{
  "name": "@aura/frontend",
  "private": true,
  "packageManager": "pnpm@12.5.0",
  "engines": { "node": ">=24.0.0", "pnpm": ">=12.0.0" },
  "scripts": {
    "start": "nx serve aura-web",
    "build": "nx build aura-web",
    "build:production": "nx build aura-web --configuration=production",
    "lint": "nx run-many -t lint",
    "test": "vitest run --config vitest.workspace.ts",
    "test:watch": "vitest",
    "storybook": "nx run storybook:storybook",
    "build-storybook": "nx run storybook:build-storybook",
    "e2e": "playwright test",
    "pwa:inject": "node --input-type=module -e \"import config from './workbox-config.mjs'; import { injectManifest } from 'workbox-build'; await injectManifest(config);\""
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@nx/angular": "^23.0.0",
    "@nx/eslint": "^23.0.0",
    "@nx/eslint-plugin": "^23.0.0",
    "@nx/js": "^23.0.0",
    "@nx/workspace": "^23.0.0",
    "@nx/storybook": "^23.0.0",
    "nx": "^23.0.0",
    "@storybook/angular": "^8.6.14",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "storybook": "^8.6.14",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@playwright/test": "^1.52.0",
    "@axe-core/playwright": "^4.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "workbox-build": "^7.3.0",
    "workbox-cli": "^7.3.0"
  }
}
