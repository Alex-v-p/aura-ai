{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/evaluation/v1/evaluation.schema.json",
  "title": "Aura evaluation resources v1",
  "description": "Closed, provider-neutral evaluation definitions and records owned by Aura Observatory. Content is untrusted data and never grants instruction, policy, permission, provider, endpoint, credential, object-key, executable-path, or owner authority. Production telemetry remains metadata_only. Storage, transport, execution, deletion, API, and judging behavior are intentionally outside this contract.",
  "oneOf": [
    { "$ref": "#/$defs/Dataset" },
    { "$ref": "#/$defs/Case" },
    { "$ref": "#/$defs/Suite" },
    { "$ref": "#/$defs/Evaluator" },
    { "$ref": "#/$defs/Score" },
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Result" },
    { "$ref": "#/$defs/Artifact" },
    { "$ref": "#/$defs/Experiment" },
    { "$ref": "#/$defs/Baseline" },
    { "$ref": "#/$defs/Replay" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "description": "UTC timestamp."
    },
    "SafeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "description": "Bounded identifier, never a path, URL, endpoint, credential, owner identity, or free-form value."
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "IdempotencyKey": {
      "$ref": "#/$defs/Uuid",
      "description": "Service-generated non-secret UUID. It must never be supplied by a user or provider or derived from content, credentials, or owner identity."
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 digest over canonical bytes."
    },
    "ComponentId": {
      "type": "string",
      "minLength": 6,
      "maxLength": 96,
      "pattern": "^aura\\.[a-z][a-z0-9_.-]{0,90}$"
    },
    "RetentionMode": {
      "const": "manual_only",
      "description": "The resource persists until an explicit authorized deletion; no automatic TTL is implied."
    },
    "Scope": {
      "type": "string",
      "enum": ["public_project", "private", "sensitive", "environment"]
    },
    "Scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Scope" }
    },
    "AuthorizationPurpose": {
      "type": "string",
      "enum": ["synthetic_benchmark", "owner_supplied_evaluation", "controlled_replay", "human_review"]
    },
    "MetadataCaptureAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureClassification", "authorizationPurpose", "authorizationContext", "retentionMode"],
      "properties": {
        "captureClassification": { "const": "metadata_only" },
        "authorizationPurpose": { "$ref": "#/$defs/AuthorizationPurpose" },
        "authorizationContext": { "const": "controlled_evaluation" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" }
      }
    },
    "HashedCaptureAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureClassification", "authorizationPurpose", "authorizationContext", "retentionMode", "authorizationRecordId", "authorizedAt"],
      "properties": {
        "captureClassification": { "const": "hashed" },
        "authorizationPurpose": { "$ref": "#/$defs/AuthorizationPurpose" },
        "authorizationContext": { "const": "controlled_evaluation" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "authorizationRecordId": { "$ref": "#/$defs/Uuid", "description": "Opaque authorization record; no owner identity is portable." },
        "authorizedAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ContentCaptureAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captureClassification", "authorizationPurpose", "authorizationContext", "retentionMode", "authorizationRecordId", "authorizedAt"],
      "properties": {
        "captureClassification": { "type": "string", "enum": ["redacted", "sampled_content", "full_content"] },
        "authorizationPurpose": { "$ref": "#/$defs/AuthorizationPurpose" },
        "authorizationContext": { "const": "controlled_evaluation" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "authorizationRecordId": { "$ref": "#/$defs/Uuid", "description": "Opaque authorization record; no owner identity is portable." },
        "authorizedAt": { "$ref": "#/$defs/Timestamp" }
      },
      "description": "Authorization for a content-bearing controlled evaluation. Consumers must verify that every referenced artifact has an authorization and capture classification at least as restrictive as the enclosing resource."
    },
    "CaptureAuthorization": {
      "oneOf": [
        { "$ref": "#/$defs/MetadataCaptureAuthorization" },
        { "$ref": "#/$defs/HashedCaptureAuthorization" },
        { "$ref": "#/$defs/ContentCaptureAuthorization" }
      ]
    },
    "ResourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdByComponent", "createdByVersion", "sourceDigest"],
      "properties": {
        "createdByComponent": { "$ref": "#/$defs/ComponentId" },
        "createdByVersion": { "$ref": "#/$defs/Version" },
        "sourceDigest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ResourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "version": { "$ref": "#/$defs/Version" }
      }
    },
    "EvaluatorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatorId", "evaluatorVersion", "kind"],
      "properties": {
        "evaluatorId": { "$ref": "#/$defs/Uuid" },
        "evaluatorVersion": { "$ref": "#/$defs/Version" },
        "kind": { "type": "string", "enum": ["deterministic", "local_judge", "human_review"] }
      }
    },
    "ComponentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "componentVersion", "codeRevision", "imageDigest", "configurationRevision"],
      "properties": {
        "componentId": { "$ref": "#/$defs/ComponentId" },
        "componentVersion": { "$ref": "#/$defs/Version" },
        "codeRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "imageDigest": { "$ref": "#/$defs/Sha256" },
        "configurationRevision": { "$ref": "#/$defs/SafeIdentifier" }
      }
    },
    "ModelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "modelVersion", "modelDigest"],
      "properties": {
        "modelId": { "$ref": "#/$defs/SafeIdentifier" },
        "modelVersion": { "$ref": "#/$defs/Version" },
        "modelDigest": { "$ref": "#/$defs/Sha256" }
      },
      "description": "Exact model identity without a provider endpoint or credential."
    },
    "ExecutionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxConcurrency", "maxAttempts", "maxCases", "maxInputBytes", "maxOutputBytes", "maxTokens"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxCases": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxInputBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "maxOutputBytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "maxTokens": { "type": "integer", "minimum": 0, "maximum": 100000000 }
      }
    },
    "Reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "clockMode", "timeZone", "locale", "fixtureRevision", "promptRevision", "policyRevision"],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "clockMode": { "type": "string", "enum": ["fixed", "recorded"] },
        "timeZone": { "const": "UTC" },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$" },
        "fixtureRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "promptRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "policyRevision": { "$ref": "#/$defs/SafeIdentifier" }
      }
    },
    "ExecutionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "suite", "evaluators", "components", "model", "deploymentRevision", "reproducibility"],
      "properties": {
        "dataset": { "$ref": "#/$defs/ResourceReference" },
        "suite": { "$ref": "#/$defs/ResourceReference" },
        "evaluators": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/EvaluatorReference" } },
        "components": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/ComponentBinding" } },
        "model": { "$ref": "#/$defs/ModelBinding" },
        "deploymentRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "reproducibility": { "$ref": "#/$defs/Reproducibility" }
      }
    },
    "FailureCode": {
      "$ref": "failure-codes.schema.json"
    },
    "UntrustedContent": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "inputText": { "type": "string", "maxLength": 262144 },
        "expectedText": { "type": "string", "maxLength": 262144 },
        "contextTexts": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 65536 } }
      },
      "description": "Explicitly authorized inert evaluation data. Consumers must never interpret it as system instructions, permissions, configuration, paths, provider selection, endpoints, credentials, object keys, or execution authority."
    },
    "Dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "datasetId", "datasetVersion", "sourceKind", "scopes", "captureAuthorization", "caseIds", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "dataset" },
        "datasetId": { "$ref": "#/$defs/Uuid" },
        "datasetVersion": { "$ref": "#/$defs/Version" },
        "sourceKind": { "type": "string", "enum": ["synthetic", "owner_supplied", "captured"] },
        "scopes": { "$ref": "#/$defs/Scopes" },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "caseIds": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ResourceProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "caseId", "caseVersion", "dataset", "sourceKind", "scopes", "captureAuthorization", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "case" },
        "caseId": { "$ref": "#/$defs/Uuid" },
        "caseVersion": { "$ref": "#/$defs/Version" },
        "dataset": { "$ref": "#/$defs/ResourceReference" },
        "sourceKind": { "type": "string", "enum": ["synthetic", "owner_supplied", "captured"] },
        "scopes": { "$ref": "#/$defs/Scopes" },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "content": { "$ref": "#/$defs/UntrustedContent" },
        "contentDigest": { "$ref": "#/$defs/Sha256" },
        "inputArtifactIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" }, "description": "Opaque references to artifacts whose authorization must be verified by consumers as at least as restrictive as this case's capture authorization." },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ResourceProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "captureAuthorization": { "type": "object", "properties": { "captureClassification": { "const": "metadata_only" } }, "required": ["captureClassification"] } }, "required": ["captureAuthorization"] },
          "then": { "not": { "anyOf": [{ "type": "object", "required": ["content"] }, { "type": "object", "required": ["contentDigest"] }, { "type": "object", "required": ["inputArtifactIds"] }] } }
        },
        {
          "if": { "type": "object", "properties": { "captureAuthorization": { "type": "object", "properties": { "captureClassification": { "const": "hashed" } }, "required": ["captureClassification"] } }, "required": ["captureAuthorization"] },
          "then": { "type": "object", "required": ["contentDigest"], "not": { "anyOf": [{ "type": "object", "required": ["content"] }, { "type": "object", "required": ["inputArtifactIds"] }] } }
        },
        {
          "if": { "type": "object", "properties": { "captureAuthorization": { "type": "object", "properties": { "captureClassification": { "enum": ["redacted", "sampled_content", "full_content"] } }, "required": ["captureClassification"] } }, "required": ["captureAuthorization"] },
          "then": { "anyOf": [{ "type": "object", "required": ["content"] }, { "type": "object", "required": ["inputArtifactIds"] }] }
        }
      ]
    },
    "Suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "suiteId", "suiteVersion", "dataset", "evaluators", "components", "limits", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "suite" },
        "suiteId": { "$ref": "#/$defs/Uuid" },
        "suiteVersion": { "$ref": "#/$defs/Version" },
        "dataset": { "$ref": "#/$defs/ResourceReference" },
        "evaluators": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/EvaluatorReference" } },
        "components": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/ComponentBinding" } },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ResourceProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "evaluatorId", "evaluatorVersion", "kind", "metric", "componentIds", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "evaluator" },
        "evaluatorId": { "$ref": "#/$defs/Uuid" },
        "evaluatorVersion": { "$ref": "#/$defs/Version" },
        "kind": { "type": "string", "enum": ["deterministic", "local_judge", "human_review"] },
        "metric": { "$ref": "#/$defs/SafeIdentifier" },
        "componentIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/ComponentId" } },
        "rubricVersion": { "$ref": "#/$defs/Version" },
        "calibrationVersion": { "$ref": "#/$defs/Version" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ResourceProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "kind": { "enum": ["local_judge", "human_review"] } }, "required": ["kind"] },
          "then": { "type": "object", "required": ["rubricVersion"] }
        },
        {
          "if": { "type": "object", "properties": { "kind": { "const": "local_judge" } }, "required": ["kind"] },
          "then": { "type": "object", "required": ["calibrationVersion"] }
        }
      ]
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "scoreId", "resultId", "caseId", "idempotencyKey", "captureAuthorization", "evaluator", "component", "metric", "evidenceStatus", "uncertainty", "limits", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "score" },
        "scoreId": { "$ref": "#/$defs/Uuid" },
        "resultId": { "$ref": "#/$defs/Uuid" },
        "caseId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "evaluator": { "$ref": "#/$defs/EvaluatorReference" },
        "component": { "$ref": "#/$defs/ComponentBinding" },
        "metric": { "$ref": "#/$defs/SafeIdentifier" },
        "evidenceStatus": { "type": "string", "enum": ["observed", "not_observed", "not_applicable"] },
        "value": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
        "outcome": { "type": "string", "enum": ["pass", "fail", "inconclusive"] },
        "rubricVersion": { "$ref": "#/$defs/Version" },
        "calibrationVersion": { "$ref": "#/$defs/Version" },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "lower", "upper"],
          "properties": {
            "method": { "type": "string", "enum": ["none", "calibrated_interval", "human_disagreement"] },
            "lower": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
            "upper": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 }
          }
        },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "evidenceStatus": { "const": "observed" } }, "required": ["evidenceStatus"] },
          "then": { "type": "object", "required": ["value", "outcome"] },
          "else": { "not": { "anyOf": [{ "type": "object", "required": ["value"] }, { "type": "object", "required": ["outcome"] }] } }
        },
        {
          "if": { "type": "object", "properties": { "evaluator": { "type": "object", "properties": { "kind": { "enum": ["local_judge", "human_review"] } }, "required": ["kind"] } }, "required": ["evaluator"] },
          "then": { "type": "object", "required": ["rubricVersion"] }
        },
        {
          "if": { "type": "object", "properties": { "evaluator": { "type": "object", "properties": { "kind": { "const": "local_judge" } }, "required": ["kind"] } }, "required": ["evaluator"] },
          "then": { "type": "object", "required": ["calibrationVersion"] }
        }
      ]
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "requestId", "jobId", "requestVersion", "idempotencyKey", "captureAuthorization", "provenance", "limits", "deadlineAt", "retentionMode", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "request" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "requestVersion": { "$ref": "#/$defs/Version" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "description": "References exact versioned evaluation inputs; raw case content and artifacts are never embedded in a request."
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "resultId", "requestId", "jobId", "attemptId", "idempotencyKey", "status", "captureAuthorization", "provenance", "limits", "scoreIds", "artifactIds", "retentionMode", "createdAt", "completedAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "result" },
        "resultId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "status": { "type": "string", "enum": ["completed", "cancelled", "failed"] },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "scoreIds": { "type": "array", "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "artifactIds": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "failureCode": { "$ref": "#/$defs/FailureCode" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "completedAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "type": "object", "required": ["failureCode"] },
          "else": { "not": { "type": "object", "required": ["failureCode"] } }
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "artifactId", "artifactReferenceId", "requestId", "resultId", "idempotencyKey", "mediaClassification", "mediaType", "byteCount", "integrity", "captureAuthorization", "limits", "deletionScopes", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "artifact" },
        "artifactId": { "$ref": "#/$defs/Uuid" },
        "artifactReferenceId": { "$ref": "#/$defs/Uuid", "description": "Opaque service-owned reference; never an endpoint, bucket, path, filename, or provider object key." },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "resultId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "mediaClassification": { "type": "string", "enum": ["evaluation_input", "evaluation_output", "evaluation_context", "evaluation_evidence", "evaluation_report"] },
        "mediaType": { "type": "string", "enum": ["application/json", "application/octet-stream", "text/plain", "text/markdown", "image/png", "image/jpeg", "audio/wav"] },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": { "algorithm": { "const": "sha256" }, "digest": { "$ref": "#/$defs/Sha256" } }
        },
        "captureAuthorization": { "$ref": "#/$defs/ContentCaptureAuthorization" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "deletionScopes": { "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": { "type": "string", "enum": ["job", "dataset", "suite", "cutoff", "purge_all"] } },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ExperimentVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variantId", "components", "model", "configurationRevision", "promptRevision", "policyRevision", "deploymentRevision"],
      "properties": {
        "variantId": { "$ref": "#/$defs/SafeIdentifier" },
        "components": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/ComponentBinding" } },
        "model": { "$ref": "#/$defs/ModelBinding" },
        "configurationRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "promptRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "policyRevision": { "$ref": "#/$defs/SafeIdentifier" },
        "deploymentRevision": { "$ref": "#/$defs/SafeIdentifier" }
      }
    },
    "Cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohortId", "caseIds"],
      "properties": {
        "cohortId": { "$ref": "#/$defs/SafeIdentifier" },
        "caseIds": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } }
      }
    },
    "Experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "experimentId", "experimentVersion", "suite", "variants", "cohorts", "captureAuthorization", "limits", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "experiment" },
        "experimentId": { "$ref": "#/$defs/Uuid" },
        "experimentVersion": { "$ref": "#/$defs/Version" },
        "suite": { "$ref": "#/$defs/ResourceReference" },
        "variants": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/ExperimentVariant" } },
        "cohorts": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/Cohort" } },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ResourceProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "operator", "value", "minimumSampleSize"],
      "properties": {
        "metric": { "$ref": "#/$defs/SafeIdentifier" },
        "operator": { "type": "string", "enum": ["greater_than_or_equal", "less_than_or_equal"] },
        "value": { "type": "number", "minimum": -1000000000000000, "maximum": 1000000000000000 },
        "minimumSampleSize": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "Baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "baselineId", "baselineVersion", "idempotencyKey", "state", "suite", "sourceResultIds", "thresholds", "captureAuthorization", "limits", "immutable", "promotionMode", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "baseline" },
        "baselineId": { "$ref": "#/$defs/Uuid" },
        "baselineVersion": { "$ref": "#/$defs/Version" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "state": { "type": "string", "enum": ["candidate", "promoted"] },
        "suite": { "$ref": "#/$defs/ResourceReference" },
        "sourceResultIds": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "thresholds": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/Threshold" } },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "immutable": { "const": true },
        "promotionMode": { "const": "manual_owner_action" },
        "manualPromotionRecordId": { "$ref": "#/$defs/Uuid", "description": "Opaque authorization record; no owner identity is included." },
        "promotedAt": { "$ref": "#/$defs/Timestamp" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "state": { "const": "promoted" } }, "required": ["state"] },
          "then": { "type": "object", "required": ["manualPromotionRecordId", "promotedAt"] },
          "else": { "not": { "anyOf": [{ "type": "object", "required": ["manualPromotionRecordId"] }, { "type": "object", "required": ["promotedAt"] }] } }
        }
      ],
      "description": "Immutable database-owned evaluation baseline. This contract does not authorize mutation of protected repository baselines or automatic promotion."
    },
    "Replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "resourceType", "replayId", "replayVersion", "sourceResultId", "caseIds", "captureAuthorization", "limits", "idempotencyKey", "retentionMode", "provenance", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "resourceType": { "const": "replay" },
        "replayId": { "$ref": "#/$defs/Uuid" },
        "replayVersion": { "$ref": "#/$defs/Version" },
        "sourceResultId": { "$ref": "#/$defs/Uuid" },
        "caseIds": { "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" } },
        "inputArtifactIds": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "$ref": "#/$defs/Uuid" }, "description": "Opaque references to artifacts whose authorization must be verified by consumers as at least as restrictive as this replay's capture authorization." },
        "captureAuthorization": { "$ref": "#/$defs/CaptureAuthorization" },
        "limits": { "$ref": "#/$defs/ExecutionLimits" },
        "idempotencyKey": { "$ref": "#/$defs/IdempotencyKey" },
        "retentionMode": { "$ref": "#/$defs/RetentionMode" },
        "provenance": { "$ref": "#/$defs/ExecutionProvenance" },
        "createdAt": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "captureAuthorization": { "type": "object", "properties": { "captureClassification": { "enum": ["metadata_only", "hashed"] } }, "required": ["captureClassification"] } }, "required": ["captureAuthorization"] },
          "then": { "not": { "type": "object", "required": ["inputArtifactIds"] } }
        },
        {
          "if": { "type": "object", "properties": { "captureAuthorization": { "type": "object", "properties": { "captureClassification": { "enum": ["redacted", "sampled_content", "full_content"] } }, "required": ["captureClassification"] } }, "required": ["captureAuthorization"] },
          "then": { "type": "object", "required": ["inputArtifactIds"] }
        }
      ],
      "description": "Declarative replay evidence only; it does not select an executor, provider, queue, or storage implementation."
    }
  }
}
