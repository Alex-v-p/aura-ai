{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.local/contracts/evaluation/v1/evaluation-runner-transport.schema.json",
  "title": "Aura evaluation runner transport v1",
  "description": "Closed, content-free NATS command and terminal-result envelopes for the controlled Core evaluation runner. Messages carry only bounded identifiers, opaque artifact references, hashes, authorizations, limits, deadlines, provenance, reproducibility evidence, finite status, and finite failure codes. Raw inputs, outputs, prompts, rubrics, comments, artifact bytes, credentials, endpoints, bucket names, object keys, paths, filenames, owner identity, exception text, arbitrary attributes, and execution authority are prohibited.",
  "oneOf": [
    { "$ref": "#/$defs/RunnerRequest" },
    { "$ref": "#/$defs/CancellationRequest" },
    { "$ref": "#/$defs/CompletedResult" },
    { "$ref": "#/$defs/CancelledResult" },
    { "$ref": "#/$defs/FailedResult" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "description": "UTC timestamp."
    },
    "SafeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "description": "Bounded service-owned identifier, never content, a path, URL, endpoint, credential, provider key, or owner identity."
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 digest over canonical bytes."
    },
    "RunnerLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution",
        "maxQueueTimeMs",
        "maxModelCalls",
        "maxArtifactOperations"
      ],
      "properties": {
        "execution": { "$ref": "evaluation.schema.json#/$defs/ExecutionLimits" },
        "maxQueueTimeMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
        "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "maxArtifactOperations": { "type": "integer", "minimum": 0, "maximum": 10000 }
      },
      "description": "Caller-declared bounded execution ceilings."
    },
    "ArtifactIntegrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/Sha256" }
      }
    },
    "InputArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactReferenceId",
        "mediaClassification",
        "mediaType",
        "byteCount",
        "integrity",
        "captureAuthorization"
      ],
      "properties": {
        "artifactReferenceId": {
          "$ref": "#/$defs/Uuid",
          "description": "Opaque reference whose locator is derived internally; never a bucket, endpoint, path, filename, or provider object key."
        },
        "mediaClassification": {
          "type": "string",
          "enum": ["evaluation_input", "evaluation_context", "evaluation_evidence"]
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/json",
            "application/octet-stream",
            "text/plain",
            "text/markdown",
            "image/png",
            "image/jpeg",
            "audio/wav"
          ]
        },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "integrity": { "$ref": "#/$defs/ArtifactIntegrity" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/ContentCaptureAuthorization" }
      }
    },
    "OutputArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactReferenceId",
        "mediaClassification",
        "mediaType",
        "byteCount",
        "integrity",
        "captureAuthorization"
      ],
      "properties": {
        "artifactReferenceId": {
          "$ref": "#/$defs/Uuid",
          "description": "Opaque reference whose locator is derived internally; never a bucket, endpoint, path, filename, or provider object key."
        },
        "mediaClassification": {
          "type": "string",
          "enum": ["evaluation_output", "evaluation_evidence", "evaluation_report"]
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "application/json",
            "application/octet-stream",
            "text/plain",
            "text/markdown",
            "image/png",
            "image/jpeg",
            "audio/wav"
          ]
        },
        "byteCount": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "integrity": { "$ref": "#/$defs/ArtifactIntegrity" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/ContentCaptureAuthorization" }
      }
    },
    "EvidenceStatus": {
      "type": "string",
      "enum": ["verified", "missing", "mismatched"]
    },
    "SafeValueEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/EvidenceStatus" },
        "observedValue": { "$ref": "#/$defs/SafeIdentifier" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "not": { "required": ["observedValue"] } },
          "else": { "required": ["observedValue"] }
        }
      ]
    },
    "DigestEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/EvidenceStatus" },
        "observedValue": { "$ref": "#/$defs/Sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "not": { "required": ["observedValue"] } },
          "else": { "required": ["observedValue"] }
        }
      ]
    },
    "VersionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/EvidenceStatus" },
        "observedValue": { "$ref": "#/$defs/Version" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "not": { "required": ["observedValue"] } },
          "else": { "required": ["observedValue"] }
        }
      ]
    },
    "SeedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/EvidenceStatus" },
        "observedValue": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "missing" } }, "required": ["status"] },
          "then": { "not": { "required": ["observedValue"] } },
          "else": { "required": ["observedValue"] }
        }
      ]
    },
    "RuntimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentVersion",
        "codeRevision",
        "imageDigest",
        "configurationRevision",
        "modelId",
        "modelVersion",
        "modelDigest",
        "deploymentRevision",
        "fixtureRevision",
        "promptRevision",
        "policyRevision",
        "seed"
      ],
      "properties": {
        "componentVersion": { "$ref": "#/$defs/VersionEvidence" },
        "codeRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "imageDigest": { "$ref": "#/$defs/DigestEvidence" },
        "configurationRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "modelId": { "$ref": "#/$defs/SafeValueEvidence" },
        "modelVersion": { "$ref": "#/$defs/VersionEvidence" },
        "modelDigest": { "$ref": "#/$defs/DigestEvidence" },
        "deploymentRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "fixtureRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "promptRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "policyRevision": { "$ref": "#/$defs/SafeValueEvidence" },
        "seed": { "$ref": "#/$defs/SeedEvidence" }
      },
      "description": "Observed runtime evidence for every reproducibility binding. Missing and mismatched values are explicit and never inferred."
    },
    "RequestData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionKind",
        "requestVersion",
        "targetComponent",
        "captureAuthorization",
        "provenance",
        "limits",
        "deadlineAt",
        "caseIds",
        "inputArtifactReferences"
      ],
      "properties": {
        "executionKind": { "type": "string", "enum": ["module_replay", "synthetic_end_to_end"] },
        "requestVersion": { "$ref": "#/$defs/Version" },
        "targetComponent": { "$ref": "evaluation.schema.json#/$defs/ComponentBinding" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/CaptureAuthorization" },
        "provenance": { "$ref": "evaluation.schema.json#/$defs/ExecutionProvenance" },
        "limits": { "$ref": "#/$defs/RunnerLimits" },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" },
        "caseIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Uuid" }
        },
        "inputArtifactReferences": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/InputArtifactReference" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "captureAuthorization": {
                "type": "object",
                "properties": {
                  "captureClassification": { "enum": ["metadata_only", "hashed"] }
                },
                "required": ["captureClassification"]
              }
            },
            "required": ["captureAuthorization"]
          },
          "then": {
            "properties": { "inputArtifactReferences": { "type": "array", "maxItems": 0 } }
          }
        }
      ],
      "description": "Declarative bounded work only. The execution kind cannot select an import, provider, model endpoint, tool, subject, queue, storage location, permission, or credential."
    },
    "CancellationData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cancellationId", "reasonCode", "deadlineAt"],
      "properties": {
        "cancellationId": { "$ref": "#/$defs/Uuid" },
        "reasonCode": { "type": "string", "enum": ["OWNER_REQUESTED", "SUPERSEDED"] },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "CompletedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "resultDigest",
        "status",
        "startedAt",
        "completedAt",
        "deadlineAt",
        "captureAuthorization",
        "effectiveLimits",
        "provenance",
        "runtimeEvidence",
        "outputArtifactReferences"
      ],
      "properties": {
        "resultId": { "$ref": "#/$defs/Uuid" },
        "resultDigest": { "$ref": "#/$defs/Sha256" },
        "status": { "const": "completed" },
        "startedAt": { "$ref": "#/$defs/Timestamp" },
        "completedAt": { "$ref": "#/$defs/Timestamp" },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/CaptureAuthorization" },
        "effectiveLimits": { "$ref": "#/$defs/RunnerLimits" },
        "provenance": { "$ref": "evaluation.schema.json#/$defs/ExecutionProvenance" },
        "runtimeEvidence": { "$ref": "#/$defs/RuntimeEvidence" },
        "outputArtifactReferences": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/OutputArtifactReference" }
        }
      }
    },
    "CancelledData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "resultDigest",
        "status",
        "reasonCode",
        "completedAt",
        "deadlineAt",
        "captureAuthorization",
        "effectiveLimits",
        "provenance",
        "runtimeEvidence"
      ],
      "properties": {
        "resultId": { "$ref": "#/$defs/Uuid" },
        "resultDigest": { "$ref": "#/$defs/Sha256" },
        "status": { "const": "cancelled" },
        "reasonCode": {
          "type": "string",
          "enum": ["OWNER_REQUESTED", "DEADLINE_EXCEEDED", "SUPERSEDED", "SHUTDOWN"]
        },
        "completedAt": { "$ref": "#/$defs/Timestamp" },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/CaptureAuthorization" },
        "effectiveLimits": { "$ref": "#/$defs/RunnerLimits" },
        "provenance": { "$ref": "evaluation.schema.json#/$defs/ExecutionProvenance" },
        "runtimeEvidence": { "$ref": "#/$defs/RuntimeEvidence" }
      }
    },
    "FailedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultId",
        "resultDigest",
        "status",
        "failureCode",
        "retryable",
        "completedAt",
        "deadlineAt",
        "captureAuthorization",
        "effectiveLimits",
        "provenance",
        "runtimeEvidence"
      ],
      "properties": {
        "resultId": { "$ref": "#/$defs/Uuid" },
        "resultDigest": { "$ref": "#/$defs/Sha256" },
        "status": { "const": "failed" },
        "failureCode": { "$ref": "failure-codes.schema.json" },
        "retryable": { "type": "boolean" },
        "completedAt": { "$ref": "#/$defs/Timestamp" },
        "deadlineAt": { "$ref": "#/$defs/Timestamp" },
        "captureAuthorization": { "$ref": "evaluation.schema.json#/$defs/CaptureAuthorization" },
        "effectiveLimits": { "$ref": "#/$defs/RunnerLimits" },
        "provenance": { "$ref": "evaluation.schema.json#/$defs/ExecutionProvenance" },
        "runtimeEvidence": { "$ref": "#/$defs/RuntimeEvidence" }
      },
      "description": "Failure is finite and content-free; exception strings and provider diagnostics are never transported."
    },
    "RunnerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "messageType", "occurredAt", "correlationId", "causationId",
        "requestId", "jobId", "attemptId", "idempotencyKey", "requestDigest", "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "messageType": { "const": "evaluation.runner.requested" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "causationId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/Uuid" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "data": { "$ref": "#/$defs/RequestData" }
      }
    },
    "CancellationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "messageType", "occurredAt", "correlationId", "causationId",
        "requestId", "jobId", "attemptId", "idempotencyKey", "requestDigest", "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "messageType": { "const": "evaluation.runner.cancellation_requested" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "causationId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/Uuid" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "data": { "$ref": "#/$defs/CancellationData" }
      }
    },
    "CompletedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "messageType", "occurredAt", "correlationId", "causationId",
        "requestId", "jobId", "attemptId", "idempotencyKey", "requestDigest", "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "messageType": { "const": "evaluation.runner.completed" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "causationId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/Uuid" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "data": { "$ref": "#/$defs/CompletedData" }
      }
    },
    "CancelledResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "messageType", "occurredAt", "correlationId", "causationId",
        "requestId", "jobId", "attemptId", "idempotencyKey", "requestDigest", "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "messageType": { "const": "evaluation.runner.cancelled" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "causationId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/Uuid" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "data": { "$ref": "#/$defs/CancelledData" }
      }
    },
    "FailedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "messageId", "messageType", "occurredAt", "correlationId", "causationId",
        "requestId", "jobId", "attemptId", "idempotencyKey", "requestDigest", "data"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "messageType": { "const": "evaluation.runner.failed" },
        "occurredAt": { "$ref": "#/$defs/Timestamp" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "causationId": { "$ref": "#/$defs/Uuid" },
        "requestId": { "$ref": "#/$defs/Uuid" },
        "jobId": { "$ref": "#/$defs/Uuid" },
        "attemptId": { "$ref": "#/$defs/Uuid" },
        "idempotencyKey": { "$ref": "#/$defs/Uuid" },
        "requestDigest": { "$ref": "#/$defs/Sha256" },
        "data": { "$ref": "#/$defs/FailedData" }
      }
    }
  }
}
