# Opt-in switches.  Providers are not admitted by Core unless each switch is
# explicitly enabled after the security and hostile-page acceptance suites.
AURA_RESEARCH_SEARCH_ENABLED=false
AURA_RESEARCH_SEARCH_DRAINING=false
AURA_RESEARCH_SEARCH_IMMEDIATE_STOP=false
AURA_RESEARCH_STATIC_ENABLED=false
AURA_RESEARCH_STATIC_DRAINING=false
AURA_RESEARCH_STATIC_IMMEDIATE_STOP=false
AURA_RESEARCH_BROWSER_ENABLED=false
AURA_RESEARCH_BROWSER_DRAINING=false
AURA_RESEARCH_BROWSER_IMMEDIATE_STOP=false
# Public verification key only; never place a private signing key in this file.
AURA_PROVIDER_PUBLIC_KEY_FILE=/run/provider/public-key
AURA_PROVIDER_PUBLIC_KEY_HOST_PATH=./deploy/research/provider-public-key
# Required only when the search provider is enabled; keep this operator-local
# file outside source control. Compose never renders the secret value.
SEARXNG_SECRET_KEY_HOST_PATH=./deploy/research/searxng-secret
# Operator must provision an actual enforcing public-HTTPS egress dataplane
# (controlled DNS, DNS-rebinding protection, and public TCP/443 only) before
# enabling any provider. This repository's overlay fails closed when that
# network is absent but does not itself create or enforce the dataplane.
AURA_RESEARCH_EGRESS_NETWORK=aura-research-egress
# Absolute path inside each provider to an operator-supplied executable
# attestation probe. It must emit exactly aura.research.egress.attested.v1
# only after machine-verifying the authorized dataplane. Leave empty until
# that dataplane and its negative/positive probe suite are installed.
AURA_RESEARCH_EGRESS_ATTESTATION_PROBE_PATH=
